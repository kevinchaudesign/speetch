# --------------------------------------------------------------------
# Speetch — variables d'environnement (copier en .env.local et remplir)
# --------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role — JAMAIS exposée côté client
SUPABASE_SERVICE_ROLE_KEY=

# Email du propriétaire de l'agence (gate /admin)
SPEETCH_OWNER_EMAIL=

# Pepper utilisé pour hasher les mots de passe des Espaces Clients
# Générer une chaîne aléatoire longue : openssl rand -base64 48
SPEETCH_CLIENT_PASSWORD_PEPPER=

# URL publique du site (utile pour les liens absolus / OG / e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé Anthropic — utilisée par /admin/templates pour convertir un HTML en
# PageContent structuré (sections). Inutile si tu n'utilises que des templates
# « reproduction fidèle » (_raw_html).
ANTHROPIC_API_KEY=

# Clé AES-256-GCM (32 bytes hex, 64 caractères) utilisée pour chiffrer les
# secrets stockés en BDD : mot de passe IMAP/SMTP (email_accounts), clé
# API Brevo (crm_brevo_settings). Génère-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPEETCH_EMAIL_ENCRYPTION_KEY=

# Émetteur Brevo : la clé API, le sender par défaut et le reply-to sont
# désormais configurés dans l'admin (Forge → Émetteur Brevo). Ils sont
# chiffrés AES-256-GCM avec SPEETCH_EMAIL_ENCRYPTION_KEY avant stockage.
